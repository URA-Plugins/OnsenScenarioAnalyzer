<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsUraPlugin>true</IsUraPlugin>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.1</Version>

		<!-- URA 插件元数据：供发布 manifest 使用 -->
		<PluginInternalName>OnsenScenarioAnalyzer</PluginInternalName>
		<PluginDisplayName>解析温泉杯回合信息</PluginDisplayName>
		<PluginAuthor>xulai1001</PluginAuthor>
		<PluginDescription>解析温泉杯回合信息</PluginDescription>
		<PluginRepositoryUrl>https://github.com/URA-Plugins/OnsenScenarioAnalyzer</PluginRepositoryUrl>
		<PluginTargets>Cygames</PluginTargets>
		<PluginDependencies>EventLoggerPlugin</PluginDependencies>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\EventLoggerPlugin\EventLoggerPlugin.csproj">
		  <Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="i18n\Game.Designer.cs">
			<DependentUpon>Game.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="i18n\Game.resx">
			<LastGenOutput>Game.Designer.cs</LastGenOutput>
			<Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>

</Project>
